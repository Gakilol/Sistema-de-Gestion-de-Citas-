{
  "name": "novacita",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e:responsive": "playwright test tests/responsive-ui.spec.ts",
    "test:e2e:isolated": "playwright test --config=playwright.isolated.config.ts",
    "test:security": "vitest run tests/unit/security.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node seed.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-slot": "1.2.4",
    "@vercel/analytics": "1.6.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "dotenv": "17.4.2",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "^0.564.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.1",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.8.0",
    "globals": "^17.7.0",
    "postcss": "8.5.24",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.2.0",
    "ts-node": "^10.9.2",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "3.4.12",
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
